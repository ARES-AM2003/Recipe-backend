# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_DATABASE=recipe_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# API Configuration
PORT=3000
NODE_ENV=development

# OpenRouter AI API Key (for recipe extraction from URLs)
# Your API key format: sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Free models available: meta-llama/llama-3.1-8b-instruct:free
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# CORS Configuration (optional)
# CORS_ORIGIN=http://localhost:4200

# Rate Limiting (optional)
# THROTTLE_TTL=60
# THROTTLE_LIMIT=10
